<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.carsale.mapper.StoreMapper">

    <resultMap id="StoreMap" type="Store">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="address" column="address"/>
        <result property="phone" column="phone"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- 新增门店 -->
    <insert id="insertStore" parameterType="Store" useGeneratedKeys="true" keyProperty="id">
        insert into carsale_store
        (name, address, phone, status, create_time, update_time)
        values
        (#{name}, #{address}, #{phone}, #{status}, sysdate(), sysdate())
    </insert>

    <!-- 修改门店 -->
    <update id="updateStore" parameterType="Store">
        update carsale_store
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="address != null">
                address = #{address},
            </if>
            <if test="phone != null">
                phone = #{phone},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <!-- 删除门店 -->
    <delete id="deleteStoreById" parameterType="Long">
        delete from carsale_store where id = #{id}
    </delete>

    <!-- 批量删除门店 -->
    <delete id="deleteStoreByIds" parameterType="Long">
        delete from carsale_store where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 根据id查询门店 -->
    <select id="selectStoreById" parameterType="Long" resultMap="StoreMap">
        select id, name, address, phone, status, create_time, update_time
        from carsale_store
        where id = #{id}
    </select>

    <!-- 查询门店列表 -->
    <select id="selectStoreList" parameterType="Store" resultMap="StoreMap">
        select id, name, address, phone, status, create_time, update_time
        from carsale_store
        <where>
            <if test="id != null">and id = #{id}</if>
            <if test="name != null and name != ''">and name like concat('%', #{name}, '%')</if>
            <if test="address != null and address != ''">and address like concat('%', #{address}, '%')</if>
            <if test="phone != null and phone != ''">and phone = #{phone}</if>
            <if test="status != null">and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

</mapper>
