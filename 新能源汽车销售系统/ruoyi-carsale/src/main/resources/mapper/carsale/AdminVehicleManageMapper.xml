    <select id="selectVehicleById" parameterType="Long" resultMap="VehicleResult">
        <include refid="selectVehicleVo"/>
        where id = #{id}
    </select>

    <insert id="insertVehicle" parameterType="Vehicle" useGeneratedKeys="true" keyProperty="id">
        insert into carsale_vehicle
        (name, brand, price, battery_type, range_km, stock, launch_date, config_json, description, image_url)
        values
        (#{name}, #{brand}, #{price}, #{batteryType}, #{rangeKm}, #{stock}, #{launchDate}, #{configJson}, #{description}, #{imageUrl})
    </insert>

    <update id="updateVehicle" parameterType="Vehicle">
        update carsale_vehicle
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="brand != null and brand != ''">brand = #{brand},</if>
            <if test="price != null">price = #{price},</if>
            <if test="batteryType != null">battery_type = #{batteryType},</if>
            <if test="rangeKm != null">range_km = #{rangeKm},</if>
            <if test="stock != null">stock = #{stock},</if>
            <if test="launchDate != null">launch_date = #{launchDate},</if>
            <if test="configJson != null">config_json = #{configJson},</if>
            <if test="description != null">description = #{description},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteVehicleById" parameterType="Long">
        delete from carsale_vehicle where id = #{id}
    </delete>

    <delete id="deleteVehicleByIds" parameterType="String">
        delete from carsale_vehicle where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 查找stock数量小于等于5的所有车辆信息 selectStockWarningList -->
    <select id="selectStockWarningList" resultMap="VehicleResult">
        select id, name, brand, price, battery_type, range_km, stock, launch_date, config_json, description, image_url
        from carsale_vehicle
        where stock &lt;= 5

    </select>

