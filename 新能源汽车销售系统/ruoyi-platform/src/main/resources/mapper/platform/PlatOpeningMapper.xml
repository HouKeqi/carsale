<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.platform.mapper.PlatOpeningMapper">

    <resultMap type="PlatOpening" id="PlatOpeningResult">
        <result property="id"    column="id"    />
        <result property="opening"    column="opening"    />
        <result property="status"    column="status"    />
        <result property="name"    column="name"    />
        <result property="studentId"    column="student_id"    />
    </resultMap>

    <sql id="selectPlatOpeningVo">
        select id, opening, status, name, student_id from plat_opening
    </sql>

    <select id="selectPlatOpeningList" parameterType="PlatOpening" resultMap="PlatOpeningResult">
        <include refid="selectPlatOpeningVo"/>
        <where>
            <if test="opening != null  and opening != ''"> and opening = #{opening}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="studentId != null  and studentId != ''"> and student_id = #{studentId}</if>
        </where>
    </select>

    <select id="selectPlatOpeningById" parameterType="Long" resultMap="PlatOpeningResult">
        <include refid="selectPlatOpeningVo"/>
        where id = #{id}
    </select>

    <insert id="insertPlatOpening" parameterType="PlatOpening" useGeneratedKeys="true" keyProperty="id">
        insert into plat_opening
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="opening != null">opening,</if>
            <if test="status != null">status,</if>
            <if test="name != null">name,</if>
            <if test="studentId != null">student_id,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="opening != null">#{opening},</if>
            <if test="status != null">#{status},</if>
            <if test="name != null">#{name},</if>
            <if test="studentId != null">#{studentId},</if>
         </trim>
    </insert>

    <update id="updatePlatOpening" parameterType="PlatOpening">
        update plat_opening
        <trim prefix="SET" suffixOverrides=",">
            <if test="opening != null">opening = #{opening},</if>
            <if test="status != null">status = #{status},</if>
            <if test="name != null">name = #{name},</if>
        </trim>
        where student_id = #{studentId}
    </update>

    <delete id="deletePlatOpeningById" parameterType="Long">
        delete from plat_opening where id = #{id}
    </delete>

    <delete id="deletePlatOpeningByIds" parameterType="String">
        delete from plat_opening where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>


    <select id="selectPlatOpeningByStudentId" parameterType="String" resultMap="PlatOpeningResult">
        <include refid="selectPlatOpeningVo"/>
        where student_id = #{studentId}
    </select>
</mapper>
